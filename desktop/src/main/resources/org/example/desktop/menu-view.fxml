<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="900.0" prefWidth="1600.0" styleClass="menuprincipal-container" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.desktop.controller.MenuController">

    <left>
        <fx:include fx:id="sidebar" source="side-menu-view.fxml" />
    </left>

    <stylesheets>
        <URL value="@estilos/menu-principal.css" />
    </stylesheets>

    <right>
        <AnchorPane prefHeight="900.0" prefWidth="1400.0" styleClass="content-pane" BorderPane.alignment="CENTER">
            <children>

                <HBox alignment="CENTER_LEFT" layoutX="20.0" layoutY="60.0" prefWidth="1360" spacing="20" style="-fx-padding: 0 100 0 100;">
                    <HBox fx:id="welcomeBox" alignment="CENTER_LEFT" spacing="10">
                        <ImageView fitHeight="40" fitWidth="40" pickOnBounds="true" preserveRatio="true">
                            <Image url="@images/ion--home.png" />
                        </ImageView>
                        <VBox>
                            <Label fx:id="labelBienvenida" styleClass="menuprincipal-welcome-title" text="Bienvenido, (usuario)" />
                            <Label styleClass="menuprincipal-welcome-subtitle" text="Seleccione módulo para trabajar" />
                        </VBox>
                    </HBox>

                    <Pane HBox.hgrow="ALWAYS" />

                    <Button fx:id="btnPerfilUsuario" onAction="#irPerfilUsuario" styleClass="menuprincipal-perfil-button">
                        <graphic>
                            <ImageView fitHeight="35" fitWidth="35" pickOnBounds="true" preserveRatio="true">
                                <Image url="@images/user.png" />
                            </ImageView>
                        </graphic>
                    </Button>
                </HBox>

                <Button fx:id="boton" layoutX="158.0" layoutY="203.0" mnemonicParsing="false" prefHeight="200.0" prefWidth="200.0" styleClass="menuprincipal-button, punto-venta">
                    <graphic>
                        <VBox alignment="CENTER" spacing="10">
                            <ImageView fx:id="icono" fitHeight="80.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true">
                                <Image url="@images/majesticons--shopping-cart.png" />
                            </ImageView>
                            <Label fx:id="texto" styleClass="button-text" text="Punto de Venta" textFill="WHITE" />
                        </VBox>
                    </graphic>
                </Button>

                <Button fx:id="btnInventario" layoutX="372.0" layoutY="203.0" mnemonicParsing="false" onAction="#irInventario" prefHeight="200.0" prefWidth="200.0" styleClass="menuprincipal-button, inventario">
                    <graphic>
                        <VBox alignment="CENTER" spacing="10">
                            <ImageView fitHeight="80.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true">
                                <Image url="@images/mage--package-box-fill.png" />
                            </ImageView>
                            <Label styleClass="button-text" text="Inventario/Productos" textFill="WHITE" />
                        </VBox>
                    </graphic>
                </Button>

                <Button fx:id="btnProveedores" layoutX="587.0" layoutY="203.0" mnemonicParsing="false" onAction="#irProveedores" prefHeight="200.0" prefWidth="200.0" styleClass="menuprincipal-button, proveedores">
                    <graphic>
                        <VBox alignment="CENTER" spacing="10">
                            <ImageView fitHeight="80.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true">
                                <Image url="@images/weui--contacts-filled.png" />
                            </ImageView>
                            <Label styleClass="button-text" text="Proveedores" textFill="WHITE" />
                        </VBox>
                    </graphic>
                </Button>

                <Button fx:id="btnGraficos" layoutX="801.0" layoutY="203.0" mnemonicParsing="false" onAction="#irReportes" prefHeight="200.0" prefWidth="200.0" styleClass="menuprincipal-button, productos">
                    <graphic>
                        <VBox alignment="CENTER" spacing="10">
                            <ImageView fitHeight="80.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true">
                                <Image url="@images/icomoon-free--stats-bars.png" />
                            </ImageView>
                            <Label styleClass="button-text" text="Gráfico de Inventario" textFill="WHITE" />
                        </VBox>
                    </graphic>
                </Button>

                <Button fx:id="btnGraficos1" layoutX="1015.0" layoutY="203.0" mnemonicParsing="false" prefHeight="200.0" prefWidth="200.0" styleClass="menuprincipal-button, productos">
                    <graphic>
                        <VBox alignment="CENTER" spacing="10">
                            <ImageView fitHeight="80.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true">
                                <Image url="@images/icomoon-free--stats-bars.png" />
                            </ImageView>
                            <Label styleClass="button-text" text="Backups" textFill="WHITE" />
                        </VBox>
                    </graphic>
                </Button>

                <VBox layoutX="72.0" layoutY="451.0" prefHeight="344.0" prefWidth="600.0" styleClass="menuprincipal-info-section">
                    <Label styleClass="menuprincipal-section-header" text="Información General" />
                    <VBox spacing="15" styleClass="menuprincipal-info-content">

                        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="menuprincipal-info-item">
                            <Label styleClass="menuprincipal-info-icon, stock-icon" text="📦" />
                            <VBox spacing="2">
                                <Label styleClass="menuprincipal-info-label" text="Unidades en stock" />
                                <Label fx:id="lblUnidadesStock" styleClass="menuprincipal-info-value" text="1.245 unidades" />
                            </VBox>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="menuprincipal-info-item">
                            <Label styleClass="menuprincipal-info-icon, value-icon" text="💰" />
                            <VBox spacing="2">
                                <Label styleClass="menuprincipal-info-label" text="Valor total del inventario" />
                                <Label fx:id="lblValorInventario" styleClass="menuprincipal-info-value" text="4.520.300" />
                            </VBox>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" layoutX="10.0" layoutY="96.0" spacing="15" styleClass="menuprincipal-info-item">
                            <Label styleClass="menuprincipal-info-icon, warning-icon" text="⚠" />
                            <VBox spacing="2">
                                <Label styleClass="menuprincipal-info-label" text="Productos con stock crítico" />
                                <Label fx:id="lblProductosCriticos" styleClass="menuprincipal-info-value" text="8 productos" />
                            </VBox>
                        </HBox>

                    </VBox>
                </VBox>


                <VBox layoutX="700.0" layoutY="450.0" prefHeight="345.0" prefWidth="600.0" styleClass="menuprincipal-info-section">
                    <Label styleClass="menuprincipal-section-header" text="🥧 TOP 5 Productos Más Vendidos" />

                    <VBox spacing="5" styleClass="menuprincipal-info-content">
                        <PieChart fx:id="miniPieChart" animated="true" clockwise="true" labelsVisible="false" legendSide="RIGHT" legendVisible="true" prefHeight="180" prefWidth="580" styleClass="menuprincipal-mini-chart">
                        </PieChart>

                        <HBox alignment="CENTER" spacing="10" style="-fx-padding: 5 0 0 0;">
                            <VBox alignment="CENTER" spacing="2" styleClass="menuprincipal-mini-stats">
                                <Label fx:id="lblMiniTotalVentas" styleClass="menuprincipal-mini-stats-value" text="0" />
                                <Label styleClass="menuprincipal-mini-stats-label" text="Total Ventas" />
                            </VBox>
                            <VBox alignment="CENTER" spacing="2" styleClass="menuprincipal-mini-stats">
                                <Label fx:id="lblMiniTopProducto" styleClass="menuprincipal-mini-stats-value" text="-" />
                                <Label styleClass="menuprincipal-mini-stats-label" text="Top Producto" />
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>

            </children>
        </AnchorPane>
    </right>
</BorderPane>
