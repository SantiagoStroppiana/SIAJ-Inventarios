<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="550.0" prefWidth="800.0" spacing="20.0" styleClass="modern-profile-container" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.desktop.controller.PefilUserController">

    <stylesheets>
        <URL value="@estilos/profile-users.css" />
    </stylesheets>

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <VBox alignment="CENTER" spacing="15.0" styleClass="modern-header">
        <ImageView fx:id="imgPerfil" fitHeight="120.0" fitWidth="120.0" preserveRatio="true" styleClass="modern-avatar">
            <image>
                <Image url="@images/user.png" />
            </image>
        </ImageView>

        <Label styleClass="modern-title" text="Perfil de Usuario" />
        <Label styleClass="modern-subtitle" text="Información personal del sistema" />
    </VBox>

    <HBox spacing="40.0" alignment="CENTER">

        <VBox spacing="20.0" styleClass="modern-data-column" HBox.hgrow="ALWAYS">

            <VBox spacing="8.0" styleClass="modern-field-container">
                <Label styleClass="modern-field-label" text="NOMBRE" />
                <Label fx:id="lblNombre" styleClass="modern-field-value" text="(nombre)" />
            </VBox>

            <VBox spacing="8.0" styleClass="modern-field-container">
                <Label styleClass="modern-field-label" text="ROL DEL SISTEMA" />
                <Label fx:id="lblRol" styleClass="modern-field-rol" text="(rol)" />
            </VBox>

        </VBox>

        <VBox spacing="20.0" styleClass="modern-data-column" HBox.hgrow="ALWAYS">

            <VBox spacing="8.0" styleClass="modern-field-container">
                <Label styleClass="modern-field-label" text="APELLIDO" />
                <Label fx:id="lblApellido" styleClass="modern-field-value" text="(apellido)" />
            </VBox>

            <VBox spacing="8.0" styleClass="modern-field-container">
                <Label styleClass="modern-field-label" text="CORREO ELECTRÓNICO" />
                <Label fx:id="lblEmail" styleClass="modern-field-email" text="(email)" />
            </VBox>

        </VBox>

    </HBox>

    <HBox alignment="CENTER" spacing="20.0" styleClass="modern-actions">
        <Button fx:id="btnCambiarPassword" onAction="#cambiarPassword" styleClass="modern-btn-primary" text="Cambiar Contraseña" />
    </HBox>

    <Region VBox.vgrow="ALWAYS" />

</VBox>