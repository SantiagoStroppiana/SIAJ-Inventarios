<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="620.0" prefWidth="901.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.desktop.controller.CategoriaDetalleController">

    <stylesheets>
        <URL value="@estilos/detalle.css" />
    </stylesheets>

    <top>
        <VBox styleClass="detalle-header">
            <HBox styleClass="detalle-header-content">
                <Label styleClass="detalle-title" text="Detalles de la Categoría" />
                <Region HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="detalle-scroll-pane">
            <VBox styleClass="detalle-main-container">

                <HBox styleClass="detalle-image-section">
                    <VBox styleClass="detalle-image-container">
                        <ImageView fx:id="imgCategoria" fitHeight="200.0" fitWidth="200.0" preserveRatio="true" styleClass="detalle-product-image">
                            <image>
                                <Image url="@images/mage--package-box-fill.png" />
                            </image>
                        </ImageView>
                    </VBox>

                    <VBox styleClass="detalle-basic-info">
                        <Label fx:id="lblCategoriaNombre" styleClass="detalle-product-name" text="Nombre de la Categoría" />
                        <Label fx:id="lblCategoriaId" styleClass="detalle-product-sku" text="ID: " />
                        <HBox styleClass="detalle-status-row">
                            <Label fx:id="lblEstadoActual" styleClass="detalle-status-badge" text="Activa" />
                        </HBox>
                    </VBox>
                </HBox>

                <VBox styleClass="detalle-form-container">
                    <Label styleClass="detalle-section-title" text="Información de la Categoría" />

                    <GridPane styleClass="detalle-form-grid">
                        <columnConstraints>
                            <ColumnConstraints hgrow="NEVER" minWidth="120.0" prefWidth="120.0" />
                            <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                            <ColumnConstraints hgrow="NEVER" minWidth="120.0" prefWidth="120.0" />
                            <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                        </columnConstraints>

                        <Label styleClass="detalle-form-label" text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="txtNombre" promptText="Nombre de la categoría" styleClass="detalle-form-field" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label styleClass="detalle-form-label" text="Estado:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                        <SplitMenuButton fx:id="menuEstado" styleClass="detalle-form-combo" text="Estado" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                        <Label styleClass="detalle-form-label" text="Descripción:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <TextField fx:id="txtDescripcion" promptText="Descripción de la categoría" styleClass="detalle-form-field" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="1" />

                        <rowConstraints>
                            <RowConstraints />
                            <RowConstraints />
                        </rowConstraints>
                    </GridPane>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox styleClass="detalle-footer">
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnCancelar" styleClass="detalle-btn-secondary" text="Cancelar" />
            <Button fx:id="modificar" styleClass="detalle-btn-primary" text="Modificar" />
            <Button fx:id="guardar" styleClass="detalle-btn-success" text="Guardar" />
        </HBox>
    </bottom>

</BorderPane>
