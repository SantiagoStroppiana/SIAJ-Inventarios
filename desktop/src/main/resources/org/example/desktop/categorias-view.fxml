<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="800.0" styleClass="categorias-container" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.desktop.controller.CategoriaController">

    <children>
        <!-- Título de la sección -->
        <Label layoutX="14.0" layoutY="14.0" styleClass="categorias-form-title" text="Gestión de Categorías" />

        <VBox layoutX="14.0" layoutY="50.0" prefWidth="250.0" spacing="12.0">
            <children>
                <!-- Campo Nombre -->
                <VBox spacing="5.0">
                    <children>
                        <Label styleClass="categorias-field-label" text="Nombre Categoría" />
                        <TextField fx:id="txtNombre" prefHeight="32.0" prefWidth="240.0" promptText="Nombre de la categoría" styleClass="categorias-input-field" />
                    </children>
                </VBox>

                <!-- Campo Descripción -->
                <VBox spacing="5.0">
                    <children>
                        <Label styleClass="categorias-field-label" text="Descripción" />
                        <TextField fx:id="txtDescripcion" prefHeight="32.0" prefWidth="240.0" promptText="Descripción de la categoría" styleClass="categorias-input-field" />
                    </children>
                </VBox>
            </children>
        </VBox>

        <!-- Botones compactos -->
        <HBox layoutX="14.0" layoutY="220.0" spacing="10.0" styleClass="categorias-actions-container">
            <children>
                <Button fx:id="btnAgregar" prefHeight="36.0" prefWidth="110.0" styleClass="categorias-button-primary" text="Agregar" />
                <Button fx:id="btnModificar" prefHeight="36.0" prefWidth="110.0" styleClass="categorias-button-modify" text="Modificar" />
            </children>
        </HBox>

        <!-- Campo de búsqueda para la tabla -->
        <TextField fx:id="txtBuscarCategoria" layoutX="280.0" layoutY="50.0" prefHeight="32.0" prefWidth="500.0" promptText="Buscar categoría..." styleClass="categorias-input-field" />

        <!-- Tabla de categorías compacta -->
        <TableView fx:id="tablaCategorias" layoutX="280.0" layoutY="95.0" prefHeight="380.0" prefWidth="500.0" styleClass="categorias-table">
            <columns>
                <TableColumn fx:id="nombreColumn" prefWidth="200.0" text="NOMBRE" />
                <TableColumn fx:id="descripcionColumn" prefWidth="300.0" text="DESCRIPCIÓN" />
            </columns>
        </TableView>
    </children>

    <stylesheets>
        <URL value="@estilos/categorias.css" />
        <URL value="@estilos/tabla.css" />
    </stylesheets>
</AnchorPane>