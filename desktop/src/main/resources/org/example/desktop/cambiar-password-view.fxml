<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane stylesheets="@estilos/login-register.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.desktop.controller.PasswordController">

    <HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="700.0" styleClass="login-register-container">

        <VBox alignment="CENTER" prefHeight="650.0" prefWidth="300.0" spacing="20" styleClass="login-register-left-panel">
            <padding>
                <Insets bottom="40.0" left="30.0" right="30.0" top="40.0" />
            </padding>

            <VBox alignment="CENTER" spacing="15" styleClass="login-register-logo-container">
                <ImageView fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true" styleClass="login-register-logo-image">
                    <image>
                        <Image url="@images/siaj-logo.png" />
                    </image>
                </ImageView>

                <Label alignment="CENTER" styleClass="login-register-brand-title" text="SIAJ INVENTARIOS" wrapText="true" />
                <Label alignment="CENTER" styleClass="login-register-brand-subtitle" text="Sistema de gestión inteligente" wrapText="true" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <VBox alignment="CENTER" spacing="15" styleClass="login-register-register-section">
                <Label alignment="CENTER" styleClass="login-register-register-text" text="¿Necesitas ayuda?" wrapText="true" />
                <Button mnemonicParsing="false" prefHeight="45.0" prefWidth="180.0" styleClass="login-register-register-button" text="Contactar soporte" />
            </VBox>
        </VBox>

        <VBox alignment="CENTER" prefHeight="500.0" prefWidth="400.0" spacing="25" styleClass="login-register-right-panel">
            <padding>
                <Insets bottom="50.0" left="40.0" right="40.0" top="50.0" />
            </padding>

            <VBox alignment="CENTER" spacing="15" styleClass="login-register-form-header">
                <ImageView fitHeight="30.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" styleClass="login-register-form-logo">
                    <image>
                        <Image url="@images/user.png" />
                    </image>
                </ImageView>

                <Label styleClass="login-register-form-title" text="Cambiar contraseña" />
                <Label styleClass="login-register-form-subtitle" text="Actualiza tu contraseña" />
            </VBox>

            <VBox maxWidth="320.0" spacing="20" styleClass="login-register-form-container">

                <VBox fx:id="olvideBox" spacing="15">
                    <VBox spacing="8" styleClass="login-register-field-group">
                        <Label styleClass="login-register-field-label" text="Email registrado" />
                        <TextField fx:id="email" promptText="Ingrese el email registrado" styleClass="login-register-input-field" />
                    </VBox>

                    <VBox spacing="8" styleClass="login-register-field-group">
                        <Label styleClass="login-register-field-label" text="Nueva contraseña" />
                        <PasswordField fx:id="nuevaPassword" promptText="Nueva contraseña" styleClass="login-register-input-field" />
                    </VBox>

                    <VBox spacing="8" styleClass="login-register-field-group">
                        <Label styleClass="login-register-field-label" text="Repetir contraseña" />
                        <PasswordField fx:id="confirmarPassword" promptText="Repetir contraseña" styleClass="login-register-input-field" />
                    </VBox>

                    <Button fx:id="btnOlvidePassword" maxWidth="Infinity" onAction="#olvidePassword" prefHeight="45.0" styleClass="login-register-primary-button" text="Generar nueva contraseña">
                        <VBox.margin>
                            <Insets top="10.0" />
                        </VBox.margin>
                    </Button>
                </VBox>

                <VBox fx:id="cambiarBox" spacing="15">
                    <VBox spacing="8" styleClass="login-register-field-group">
                        <Label styleClass="login-register-field-label" text="Contraseña actual" />
                        <PasswordField fx:id="oldPassword" promptText="Contraseña actual" styleClass="login-register-input-field" />
                    </VBox>

                    <VBox spacing="8" styleClass="login-register-field-group">
                        <Label styleClass="login-register-field-label" text="Nueva contraseña" />
                        <PasswordField fx:id="newPassword" promptText="Nueva contraseña" styleClass="login-register-input-field" />
                    </VBox>

                    <Button fx:id="btnCambiarPassword" maxWidth="Infinity" onAction="#cambiarPassword" prefHeight="45.0" styleClass="login-register-primary-button" text="Actualizar contraseña">
                        <VBox.margin>
                            <Insets top="10.0" />
                        </VBox.margin>
                    </Button>
                </VBox>

            </VBox>

            <Region VBox.vgrow="ALWAYS" />
        </VBox>
    </HBox>

    <AnchorPane pickOnBounds="false">
        <Button fx:id="btnVolver" layoutX="10" layoutY="10" onAction="#volver" prefHeight="50.0" prefWidth="100.0" styleClass="login-register-primary-button" text="← Volver" />
    </AnchorPane>
</StackPane>
