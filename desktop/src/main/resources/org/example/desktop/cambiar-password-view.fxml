<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane stylesheets="@estilos/login-register.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.desktop.controller.PasswordController">

    <HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" styleClass="login-register-container">

        <!-- Panel Izquierdo - Información y branding -->
        <VBox alignment="CENTER" prefHeight="600.0" prefWidth="400.0" spacing="25" styleClass="login-register-left-panel">
            <padding>
                <Insets bottom="50.0" left="40.0" right="40.0" top="50.0" />
            </padding>

            <VBox alignment="CENTER" spacing="20" styleClass="login-register-logo-container">
                <ImageView fitHeight="140.0" fitWidth="140.0" pickOnBounds="true" preserveRatio="true" styleClass="login-register-logo-image">
                    <image>
                        <Image url="@images/siaj-logo.png" />
                    </image>
                </ImageView>

                <Label alignment="CENTER" styleClass="login-register-brand-title" text="SIAJ INVENTARIOS" wrapText="true" />
                <Label alignment="CENTER" styleClass="login-register-brand-subtitle" text="Sistema de gestión inteligente" wrapText="true" />
            </VBox>

            <!-- Spacer flexible -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- Sección de ayuda -->
            <VBox alignment="CENTER" spacing="18" styleClass="login-register-register-section">
                <Label alignment="CENTER" styleClass="login-register-register-text" text="¿Necesitas ayuda?" wrapText="true" />
                <Button mnemonicParsing="false" prefHeight="50.0" prefWidth="200.0" styleClass="login-register-register-button" text="Contactar soporte" />
            </VBox>
        </VBox>

        <!-- Panel Derecho - Formulario de cambio de contraseña -->
        <VBox alignment="CENTER" prefHeight="600.0" prefWidth="500.0" spacing="30" styleClass="login-register-right-panel">
            <padding>
                <Insets bottom="60.0" left="50.0" right="50.0" top="60.0" />
            </padding>

            <!-- Header del formulario -->
            <VBox alignment="CENTER" spacing="18" styleClass="login-register-form-header">
                <ImageView fitHeight="45.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true" styleClass="login-register-form-logo">
                    <image>
                        <Image url="@images/user.png" />
                    </image>
                </ImageView>

                <Label styleClass="login-register-form-title" text="Cambiar contraseña" />
                <Label styleClass="login-register-form-subtitle" text="Actualiza tu contraseña de acceso" />
            </VBox>

            <!-- Formularios -->
            <VBox maxWidth="380.0" prefWidth="380.0" spacing="25" styleClass="login-register-form-container">

                <!-- Formulario para recuperar contraseña -->
                <VBox fx:id="olvideBox" spacing="20">
                    <VBox spacing="10" styleClass="login-register-field-group">
                        <Label styleClass="login-register-field-label" text="Email registrado" />
                        <TextField fx:id="email" prefHeight="45.0" promptText="ejemplo@correo.com" styleClass="login-register-input-field" />
                    </VBox>

                    <VBox spacing="10" styleClass="login-register-field-group">
                        <Label styleClass="login-register-field-label" text="Nueva contraseña" />
                        <PasswordField fx:id="nuevaPassword" prefHeight="45.0" promptText="Ingresa tu nueva contraseña" styleClass="login-register-input-field" />
                    </VBox>

                    <VBox spacing="10" styleClass="login-register-field-group">
                        <Label styleClass="login-register-field-label" text="Repetir contraseña" />
                        <PasswordField fx:id="confirmarPassword" prefHeight="45.0" promptText="Confirma tu nueva contraseña" styleClass="login-register-input-field" />
                    </VBox>

                    <Button fx:id="btnOlvidePassword" maxWidth="Infinity" onAction="#olvidePassword" prefHeight="50.0" styleClass="login-register-primary-button" text="Generar nueva contraseña">
                        <VBox.margin>
                            <Insets top="15.0" />
                        </VBox.margin>
                    </Button>
                </VBox>

                <!-- Formulario para cambiar contraseña (usuario logueado) -->
                <VBox fx:id="cambiarBox" spacing="20">
                    <VBox spacing="10" styleClass="login-register-field-group">
                        <Label styleClass="login-register-field-label" text="Contraseña actual" />
                        <PasswordField fx:id="oldPassword" prefHeight="45.0" promptText="Tu contraseña actual" styleClass="login-register-input-field" />
                    </VBox>

                    <VBox spacing="10" styleClass="login-register-field-group">
                        <Label styleClass="login-register-field-label" text="Nueva contraseña" />
                        <PasswordField fx:id="newPassword" prefHeight="45.0" promptText="Tu nueva contraseña" styleClass="login-register-input-field" />
                    </VBox>

                    <Button fx:id="btnCambiarPassword" maxWidth="Infinity" onAction="#cambiarPassword" prefHeight="50.0" styleClass="login-register-primary-button" text="Actualizar contraseña">
                        <VBox.margin>
                            <Insets top="15.0" />
                        </VBox.margin>
                    </Button>
                </VBox>

            </VBox>

            <!-- Spacer flexible -->
            <Region VBox.vgrow="ALWAYS" />
        </VBox>
    </HBox>

    <!-- Botón de volver posicionado absolutamente -->
    <AnchorPane pickOnBounds="false">
        <Button fx:id="btnVolver" layoutX="15" layoutY="15" onAction="#volver" prefHeight="55.0" prefWidth="110.0" styleClass="login-register-primary-button" text="← Volver" />
    </AnchorPane>
</StackPane>