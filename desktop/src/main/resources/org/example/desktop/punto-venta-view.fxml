<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="800.0" prefWidth="1400.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.desktop.controller.VentaController"
            styleClass="pv-root">

    <left>
        <fx:include fx:id="sidebar" source="side-menu-view.fxml" />
    </left>

    <center>
        <HBox styleClass="pv-main-container" spacing="30.0">
            <children>

                <VBox styleClass="pv-product-panel" prefWidth="800.0">
                    <children>

                        <!-- Título + botón a la derecha -->
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="📋 Catálogo de Productos" styleClass="pv-panel-title">
                                    <font>
                                        <Font name="System Bold" size="20.0" />
                                    </font>
                                </Label>
                                <Pane HBox.hgrow="ALWAYS"/>
                                <Button text="Historial de ventas" styleClass="button" fx:id="btnHistorialVentas"/>
                            </children>
                        </HBox>

                        <!-- BUSCADOR - Nueva sección -->
                        <VBox spacing="8.0" styleClass="pv-search-container">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="pv-search-box">
                                    <children>
                                        <Label text="🔍" styleClass="pv-search-icon">
                                            <font>
                                                <Font size="16.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="searchField"
                                                   promptText="Buscar productos por nombre, código o categoría..."
                                                   styleClass="pv-search-input"
                                                   prefWidth="400.0"
                                                   HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>


                            </children>
                        </VBox>

                        <!-- Scroll con el catálogo - SOLUCIÓN MEJORADA -->
                        <ScrollPane fitToWidth="true"
                                    fitToHeight="false"
                                    styleClass="pv-products-scroll"
                                    VBox.vgrow="ALWAYS"
                                    hbarPolicy="NEVER"
                                    vbarPolicy="AS_NEEDED">
                            <content>
                                <!-- Contenedor principal que se ajusta al tamaño del ScrollPane -->
                                <VBox alignment="TOP_CENTER" spacing="0.0">
                                    <children>
                                        <!-- Mensaje cuando no hay resultados -->
                                        <VBox fx:id="noResultsContainer"
                                              alignment="CENTER"
                                              spacing="10.0"
                                              styleClass="pv-no-results"
                                              visible="false"
                                              managed="false">
                                            <children>
                                                <Label text="🔍" styleClass="pv-no-results-icon">
                                                    <font>
                                                        <Font size="48.0" />
                                                    </font>
                                                </Label>
                                                <Label text="No se encontraron productos" styleClass="pv-no-results-text">
                                                    <font>
                                                        <Font name="System Bold" size="16.0" />
                                                    </font>
                                                </Label>
                                                <Label fx:id="noResultsSubtext"
                                                       text="Intenta con otros términos de búsqueda"
                                                       styleClass="pv-no-results-subtext">
                                                    <font>
                                                        <Font size="14.0" />
                                                    </font>
                                                </Label>
                                            </children>
                                        </VBox>

                                        <GridPane fx:id="productGrid"
                                                  hgap="20.0"
                                                  vgap="20.0"
                                                  styleClass="pv-products-grid"
                                                  alignment="TOP_CENTER">
                                            <!-- Aquí el controlador cargará dinámicamente los productos -->
                                        </GridPane>

                                        <!-- Espaciador flexible que ocupa el resto del espacio -->
                                        <Region VBox.vgrow="ALWAYS" styleClass="pv-products-spacer"/>
                                    </children>
                                </VBox>
                            </content>
                        </ScrollPane>

                    </children>
                </VBox>

                <!-- Panel del carrito -->
                <VBox styleClass="pv-cart-panel" prefWidth="600.0">
                    <children>
                        <Label fx:id="cartTitleLabel" text="🛒 Carrito de Compras (0)" styleClass="pv-panel-title">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>

                        <ScrollPane fx:id="cartScrollPane" fitToWidth="true" styleClass="pv-cart-scroll"
                                    VBox.vgrow="ALWAYS"
                                    hbarPolicy="NEVER">
                            <content>
                                <VBox fx:id="cartContent" spacing="10.0" styleClass="pv-cart-content">
                                    <!-- Aquí el controlador cargará los ítems del carrito -->
                                </VBox>
                            </content>
                        </ScrollPane>

                        <!-- Footer del carrito -->
                        <VBox spacing="15.0" styleClass="pv-cart-footer">
                            <children>
                                <Separator styleClass="pv-separator" />

                                <HBox alignment="CENTER_RIGHT" spacing="15.0" styleClass="pv-total-section">
                                    <children>
                                        <Label text="Total:" styleClass="pv-total-label">
                                            <font>
                                                <Font name="System Bold" size="18.0" />
                                            </font>
                                        </Label>
                                        <Label fx:id="totalLabel" text="0.00" styleClass="pv-total-amount">
                                            <font>
                                                <Font name="System Bold" size="22.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>

                                <!-- Medio de Pago -->
                                <VBox spacing="6.0" styleClass="pv-payment-container">
                                    <children>
                                        <Label text="💰 Medio de Pago" styleClass="pv-payment-label" />
                                        <ComboBox fx:id="comboMedioPago" styleClass="pv-payment-combobox" prefWidth="220.0" />
                                    </children>
                                </VBox>

                                <VBox spacing="10.0" styleClass="pv-action-buttons">
                                    <children>
                                        <Button fx:id="btnProcesarVenta" text="💳 Procesar Venta"
                                                styleClass="pv-action-btn, pv-process-btn"
                                                prefHeight="45.0" />
                                        <Button fx:id="btnLimpiarCarrito" text="🗑️ Limpiar Carrito"
                                                styleClass="pv-action-btn, pv-clear-btn"
                                                prefHeight="35.0" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>

            </children>
        </HBox>
    </center>

    <stylesheets>
        <URL value="@estilos/estilos-globales.css" />
        <URL value="@estilos/punto-venta.css" />
    </stylesheets>
</BorderPane>