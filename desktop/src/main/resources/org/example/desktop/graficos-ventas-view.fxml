<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.*?>

<BorderPane prefHeight="620.0" prefWidth="901.0" styleClass="grafico-container" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.desktop.controller.GraficoController">

    <!-- Sidebar izquierdo -->
    <left>
        <fx:include fx:id="sidebar" source="side-menu-view.fxml" />
    </left>

    <!-- Estilos -->
    <stylesheets>
        <URL value="@estilos/grafico.css" />
    </stylesheets>

    <!-- Contenido principal con el gráfico -->
    <center>
        <VBox spacing="25" styleClass="grafico-main-content">

            <!-- Header con título y botón -->
            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="grafico-header">
                <VBox spacing="5" styleClass="grafico-title-container">
                    <Label styleClass="grafico-main-title" text="📊 Reportes de Ventas" />
                    <Label styleClass="grafico-subtitle" text="Análisis de TOP 5 productos más vendidos" />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Botón de actualizar -->
                <Button fx:id="actualizarButton"
                        onAction="#actualizarDatos"
                        styleClass="grafico-button-primary"
                        text="🔄 Actualizar" />
            </HBox>

            <!-- Contenedor del gráfico con efecto de sombra -->
            <VBox spacing="10" styleClass="grafico-chart-container">

                <!-- Indicador de carga -->
                <StackPane styleClass="grafico-progress-container">
                    <ProgressIndicator fx:id="progressIndicator"
                                       maxHeight="50" maxWidth="50"
                                       styleClass="grafico-progress-indicator"
                                       visible="false" />
                </StackPane>

                <!-- Gráfico principal -->
                <BarChart fx:id="barChart"
                          legendVisible="false"
                          prefHeight="450"
                          prefWidth="100"
                          animated="true"
                          title="🏆 TOP 5 Productos Más Vendidos"
                          styleClass="grafico-bar-chart">
                    <xAxis>
                        <CategoryAxis label="🛍️ Productos"
                                      tickLabelRotation="45"
                                      tickLabelFill="WHITE"
                                      styleClass="grafico-x-axis" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="📊 Cantidad Vendida"
                                    tickLabelFill="WHITE"
                                    styleClass="grafico-y-axis" />
                    </yAxis>
                </BarChart>
            </VBox>

            <!-- Panel inferior con estadísticas -->
            <HBox alignment="CENTER" spacing="30" styleClass="grafico-stats-panel">

                <!-- Tarjeta de estadística 1 -->
                <VBox alignment="CENTER" spacing="5" styleClass="grafico-stats-card grafico-stats-card-success">
                    <Label styleClass="grafico-stats-icon" text="📈" />
                    <Label fx:id="lblProductosActivos" styleClass="grafico-stats-value" text="5" />
                    <Label styleClass="grafico-stats-label" text="TOP Productos" />
                </VBox>

                <!-- Tarjeta de estadística 2 -->
                <VBox alignment="CENTER" spacing="5" styleClass="grafico-stats-card grafico-stats-card-warning">
                    <Label styleClass="grafico-stats-icon" text="🛍️" />
                    <Label fx:id="lblTotalVentas" styleClass="grafico-stats-value" text="0" />
                    <Label styleClass="grafico-stats-label" text="Total Ventas" />
                </VBox>

                <!-- Tarjeta de estadística 3 -->
                <VBox alignment="CENTER" spacing="5" styleClass="grafico-stats-card grafico-stats-card-info">
                    <Label styleClass="grafico-stats-icon" text="⭐" />
                    <Label fx:id="lblTopProducto" styleClass="grafico-stats-value" text="-" />
                    <Label styleClass="grafico-stats-label" text="Top Producto" />
                </VBox>

                <!-- Tarjeta de estadística 4 -->
                <VBox alignment="CENTER" spacing="5" styleClass="grafico-stats-card grafico-stats-card-primary">
                    <Label styleClass="grafico-stats-icon" text="💰" />
                    <Label fx:id="lblIngresoTotal" styleClass="grafico-stats-value" text="00" />
                    <Label styleClass="grafico-stats-label" text="Ingresos Totales" />
                </VBox>

            </HBox>
        </VBox>
    </center>
</BorderPane>